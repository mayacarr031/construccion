# =================================================================
# CONFIGURACIÓN DE BASE DE DATOS (MySQL / MariaDB)
# =================================================================
# Para conectarse al contenedor MariaDB (Local o Remoto):
# Si corres MariaDB en tu misma máquina con docker-compose:
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=lasalle
DB_NAME=db_sentimientos

# Si te conectas a la máquina de tu compañero:
# DB_HOST=IP_DE_TU_COMPAÑERO
# DB_PORT=3308

# =================================================================
# CONFIGURACIÓN DE FASTAPI
# =================================================================
FASTAPI_URL=http://127.0.0.1:8000
FASTAPI_USER=admin
FASTAPI_PASSWORD=12345

# =================================================================
# CONFIGURACIÓN DE INFERENCIA LM STUDIO (LLM LOCAL)
# =================================================================
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=bartowski/Qwen2.5-0.5B-Instruct-GGUF/Qwen2.5-0.5B-Instruct-Q4_K_L.gguf
